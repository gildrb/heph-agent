# Environment overrides for ~/.config/heph/config.toml. All are optional.

# OpenAI-compatible server (default: a local llama-server).
HEPH_BASE_URL=http://127.0.0.1:8080/v1
# Model id; empty uses the first id from GET {base_url}/models.
HEPH_MODEL=
# Only for hosted providers; local servers need no key.
HEPH_API_KEY=

# Where armories created by name live (default ~/.armories).
# HEPH_ARMORY_HOME=~/.armories
