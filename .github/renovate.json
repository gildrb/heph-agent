{
  "$schema": "https://docs.renovatebot.com/renovate-schema",
  "extends": ["config:recommended"],
  "enabledManagers": ["pep621", "github-actions", "pre-commit", "custom.regex"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "cibuildwheel run via uvx in the release workflow",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["uvx cibuildwheel==(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "cibuildwheel",
      "datasourceTemplate": "pypi"
    }
  ],
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies", "triage"],
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "lockFileMaintenance"],
      "automerge": false,
      "groupName": "non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "triage", "major-update"]
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": false,
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "labels": ["dependencies", "ci"],
      "commitMessagePrefix": "ci(deps)"
    },
    {
      "matchManagers": ["pep621"],
      "commitMessagePrefix": "chore(deps)",
      "rangeStrategy": "pin"
    }
  ],
  "prConcurrentLimit": 5,
  "schedule": ["before 9am on Monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on Monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false
  }
}
